# ==============================================================================
# MedEx Backend Environment Variables Template
# Copy to backend/.env for local development or set in deployment container
# NEVER COMMIT SECRETS TO SOURCE CONTROL
# ==============================================================================

PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# CORS Configuration (Production Security Hardening)
# ------------------------------------------------------------------------------
# In production (NODE_ENV=production):
# Must be a comma-separated list of fully qualified allowed browser origins:
# CORS_ORIGINS=https://app.medex.example.com,https://admin.medex.example.com
# Trailing slashes and whitespace are automatically trimmed.
# Wildcards (*) are strictly forbidden when credentials are enabled.
# If left empty in production, all cross-origin browser requests are blocked.
#
# In development (NODE_ENV=development):
# Local development origins (localhost:5173, localhost:3000, 127.0.0.1) are
# automatically permitted. Additional origins can be appended here.
CORS_ORIGINS=

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY: Required by backend server to persist hospital registrations
# and bypass PostgreSQL Row Level Security (RLS). Obtain from Supabase Project Dashboard
# -> Settings -> API -> Project API keys -> service_role (secret).
# NEVER EXPOSE THIS KEY IN CLIENT CODE OR SOURCE CONTROL.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# ------------------------------------------------------------------------------
# Feature Flags (Hospital Registration)
# ------------------------------------------------------------------------------
# Set to 'true' to require official email OTP verification during Step 1 hospital registration
# Set to 'false' to temporarily allow hospitals to register without email OTP challenge ($0 setup)
EMAIL_VERIFICATION_REQUIRED=false

# ------------------------------------------------------------------------------
# Security & Rate Limiting (Optional Overrides)
# ------------------------------------------------------------------------------
# TRUST_PROXY=true
# MAX_DOCUMENT_SIZE_MB=5
# AUTH_RATE_LIMIT_MAX=100
# REGISTRATION_RATE_LIMIT_MAX=50
# GENERAL_RATE_LIMIT_MAX=3000

# ------------------------------------------------------------------------------
# Email / SMTP Configuration (Hospital Verification & Registration OTPs)
# ------------------------------------------------------------------------------
# In local development:
# If SMTP_* variables are left commented out or empty, Nodemailer automatically
# falls back to a sandbox test account (Ethereal Email) and logs a one-click
# web preview URL in the terminal to view dispatched OTP emails.
#
# If SMTP is required (or for Production delivery):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-character-app-password
# SMTP_FROM="MedEx Central System" <verification@medex.org>

